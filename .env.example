# Required: choose a unique password with at least 16 characters.
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
NODE_ENV=development
# For an HTTPS reverse proxy, set these to true, 1 and your public origin.
COOKIE_SECURE=false
TRUST_PROXY=0
APP_ORIGIN=

# Optional bootstrap settings. After first dashboard save, data/bot_config.json wins.
TELEGRAM_BOT_TOKEN=
BOT_ENABLED=false
LLM_BRAIN=server_cloud
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_SPEECH_API_KEY=
FASTAPI_URL=http://127.0.0.1:8000/voice

# Optional paths if FFmpeg is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional model ID for /describe. The default uses GPT-6 Luna through the selected API endpoint.
# VISUAL_MODEL=cx/gpt-6-luna(low)
# Optional model ID for transcript correction and organization (same API key and endpoint).
# TRANSCRIPT_POLISH_MODEL=cx/gpt-6-sol(low)
